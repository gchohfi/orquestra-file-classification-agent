{
  "name": "orquestra-file-classification-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente seguro de inventário, classificação e organização de lotes XLSX/CSV.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gchohfi/orquestra-file-classification-agent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "classify": "tsx src/cli.ts",
    "audiences:preview": "tsx src/audience-preview-cli.ts",
    "audiences:approved-report": "tsx src/approved-audience-report-cli.ts",
    "audiences:enhanced-report": "tsx src/enhanced-audience-report-cli.ts",
    "workbook:view-real": "tsx src/workbook-data-view-cli.ts",
    "workbook:view-installments": "tsx src/procedure-installment-view-cli.ts"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "openai": "7.4.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/yauzl": "^2.10.3",
    "jszip": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
