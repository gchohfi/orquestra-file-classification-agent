# Copie este arquivo para .env e mantenha os valores secretos somente em .env.local.
AI_PROVIDER=openai
AI_PROVIDER_GATE_STATUS=not_approved
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_ENABLED=false

# Preenchidos localmente depois da criação do projeto Supabase.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Segredos locais, nunca versionar:
OPENAI_API_KEY=
AI_PROVIDER_APPROVAL_ID=
